[Unit]
Description=assumevalid anchor node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
ExecStart=/home/debian/assumevalid/build/bin/bitcoind -chain=assumevalid -datadir=/home/debian/av -assumevalidall -mine -rpcport=18443
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
# bitcoind shuts down cleanly on SIGTERM (systemd's default stop signal).

[Install]
WantedBy=multi-user.target
